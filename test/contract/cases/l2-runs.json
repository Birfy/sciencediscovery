    {
     "name": "execution runs",
     "request": {
      "method": "GET",
      "path": "/api/sessions/{{sessionId}}/execution-runs"
     },
     "covers": [
      "GET /api/sessions/:id/execution-runs"
     ],
     "expectStatus": 200
