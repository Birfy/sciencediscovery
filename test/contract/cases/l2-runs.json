    {
     "name": "a tool's output stream",
     "request": {
      "method": "GET",
      "path": "/api/sessions/{{sessionId}}/runs/{{runId}}/streams/tool-call-main-1/events"
     },
     "covers": [
      "GET /api/sessions/:id/runs/:runId/streams/:streamId/events"
     ],
     "expectStatus": 200
