     "always": true,
     "covers": [
      "GET /api/sessions/:id/runs/:runId"
     ]
    },
    {
     "name": "the session's runs",
     "request": {
      "method": "GET",
      "path": "/api/sessions/{{sessionId}}/runs"
     },
     "covers": [
      "GET /api/sessions/:id/runs"
     ],
