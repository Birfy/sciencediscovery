{
 "domain": "Skills, libraries, review drafts",
 "cases": [
  {
   "id": "skill-libraries-lifecycle",
   "description": "A skill library with two versions, a diff, two proposals (one published, one rejected) and a rollback. Libraries have no delete route: this case needs a fresh data directory every run.",
   "steps": [
    {
     "name": "libraries before",
     "request": {
      "method": "GET",
      "path": "/api/skill-libraries"
     },
     "covers": [
      "GET /api/skill-libraries"
     ],
     "expectStatus": 200
    },
    {
     "name": "create a library",
     "request": {
      "method": "POST",
      "path": "/api/skill-libraries",
      "body": {
       "id": "l1-lib",
       "name": "L1 library"
      }
     },
     "covers": [
      "POST /api/skill-libraries"
     ],
     "expectStatus": 201
    },
    {
     "name": "read it",
     "request": {
      "method": "GET",
      "path": "/api/skill-libraries/l1-lib"
     },
     "covers": [
      "GET /api/skill-libraries/:id"
     ],
     "expectStatus": 200
    },
    {
     "name": "read an unknown library",
     "request": {
      "method": "GET",
      "path": "/api/skill-libraries/nope"
     },
     "expectStatus": 404
    },
    {
     "name": "commit a first version",
     "request": {
      "method": "POST",
      "path": "/api/skill-libraries/l1-lib/versions",
      "body": {
       "author": {
        "kind": "user"
       },
       "operations": [
        {
         "type": "upsert",
         "package": {
          "files": [
           {
            "path": "SKILL.md",
            "content": "---\nname: l1-alpha\ndescription: The first skill.\nmetadata:\n  version: 1.0.0\n---\n\n# l1-alpha\n"
           }
          ]
         }
        }
       ]
      }
     },
     "capture": {
      "v1": "$.version.id"
     },
     "covers": [
      "POST /api/skill-libraries/:id/versions"
     ],
     "expectStatus": 201
    },
    {
     "name": "commit a second version",
     "request": {
      "method": "POST",
      "path": "/api/skill-libraries/l1-lib/versions",
      "body": {
       "author": {
        "kind": "user"
       },
       "baseVersionId": "{{v1}}",
       "operations": [
        {
         "type": "upsert",
         "package": {
          "files": [
           {
            "path": "SKILL.md",
            "content": "---\nname: l1-beta\ndescription: The second skill.\nmetadata:\n  version: 1.0.0\n---\n\n# l1-beta\n"
           }
          ]
         }
        }
       ]
      }
     },
     "capture": {
      "v2": "$.version.id"
     },
     "expectStatus": 201
    },
    {
     "name": "commit on a stale base",
     "request": {
      "method": "POST",
      "path": "/api/skill-libraries/l1-lib/versions",
      "body": {
       "author": {
        "kind": "user"
       },
       "baseVersionId": "{{v1}}",
       "operations": [
        {
         "type": "delete",
         "skillId": "l1-alpha"
        }
       ]
      }
     }
    },
    {
     "name": "list versions",
     "request": {
      "method": "GET",
      "path": "/api/skill-libraries/l1-lib/versions"
     },
     "covers": [
      "GET /api/skill-libraries/:id/versions"
     ],
     "expectStatus": 200
    },
    {
     "name": "read a version",
     "request": {
      "method": "GET",
      "path": "/api/skill-libraries/l1-lib/versions/{{v1}}"
     },
     "covers": [
      "GET /api/skill-libraries/:id/versions/:v"
     ],
     "expectStatus": 200
    },
    {
     "name": "diff two versions",
     "request": {
      "method": "GET",
      "path": "/api/skill-libraries/l1-lib/versions/{{v1}}/diff/{{v2}}"
     },
     "covers": [
      "GET /api/skill-libraries/:id/versions/:a/diff/:b"
     ],
     "expectStatus": 200
    },
    {
     "name": "search the libraries",
     "request": {
      "method": "POST",
      "path": "/api/skill-libraries/search",
      "body": {
       "query": "l1"
      }
     },
     "covers": [
      "POST /api/skill-libraries/search"
     ]
    },
    {
     "name": "propose a change",
     "request": {
      "method": "POST",
      "path": "/api/skill-libraries/l1-lib/proposals",
      "body": {
       "author": {
        "kind": "self-evolution"
       },
       "baseVersionId": "{{v2}}",
       "dryRun": true,
       "libraryId": "l1-lib",
       "operations": [
        {
         "type": "upsert",
         "package": {
          "files": [
           {
            "path": "SKILL.md",
            "content": "---\nname: l1-gamma\ndescription: The third skill.\nmetadata:\n  version: 1.0.0\n---\n\n# l1-gamma\n"
           }
          ]
         }
        }
       ],
       "rationale": "L1",
       "sourceRefs": [
        {
         "id": "run-l1",
         "kind": "run"
        }
       ]
      }
     },
     "capture": {
      "proposalId": "$.id"
     },
     "covers": [
      "POST /api/skill-libraries/:id/proposals"
     ],
     "expectStatus": 201
    },
    {
     "name": "propose a second change",
     "request": {
      "method": "POST",
      "path": "/api/skill-libraries/l1-lib/proposals",
      "body": {
       "author": {
        "kind": "self-evolution"
       },
       "baseVersionId": "{{v2}}",
       "dryRun": true,
       "libraryId": "l1-lib",
       "operations": [
        {
         "type": "upsert",
         "package": {
          "files": [
           {
            "path": "SKILL.md",
            "content": "---\nname: l1-delta\ndescription: The fourth skill.\nmetadata:\n  version: 1.0.0\n---\n\n# l1-delta\n"
           }
          ]
         }
        }
       ],
       "rationale": "L1",
       "sourceRefs": [
        {
         "id": "run-l1",
         "kind": "run"
        }
       ]
      }
     },
     "capture": {
      "proposalId2": "$.id"
     },
     "expectStatus": 201
    },
    {
     "name": "list proposals",
     "request": {
      "method": "GET",
      "path": "/api/skill-library-proposals?libraryId=l1-lib"
     },
     "covers": [
      "GET /api/skill-library-proposals"
     ],
     "expectStatus": 200
    },
    {
     "name": "publish one",
     "request": {
      "method": "POST",
      "path": "/api/skill-library-proposals/{{proposalId}}/publish"
     },
     "covers": [
      "POST /api/skill-library-proposals/:id/publish"
     ],
     "expectStatus": 201
    },
    {
     "name": "reject the other",
     "request": {
      "method": "POST",
      "path": "/api/skill-library-proposals/{{proposalId2}}/reject"
     },
     "covers": [
      "POST /api/skill-library-proposals/:id/reject"
     ],
     "expectStatus": 200
    },
    {
     "name": "publish with an empty body",
     "request": {
      "method": "POST",
      "path": "/api/skill-library-proposals/publish",
      "body": {}
     },
     "covers": [
      "POST /api/skill-library-proposals/publish"
     ]
    },
    {
     "name": "roll back to the first version",
     "request": {
      "method": "POST",
      "path": "/api/skill-libraries/l1-lib/rollback",
      "body": {
       "versionId": "{{v1}}"
      }
     },
     "covers": [
      "POST /api/skill-libraries/:id/rollback"
     ]
    }
   ]
  }
 ]
}