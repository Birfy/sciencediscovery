{
  "name": "@sciencediscovery/plugin-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./dist/manifest.js"
    },
    "./web": {
      "types": "./src/web.tsx",
      "default": "./dist/web.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sciencediscovery/plugin-sdk": "workspace:*",
    "@sciencediscovery/workspace": "workspace:*",
    "@sciencediscovery/context": "workspace:*",
    "@sciencediscovery/runtime-core": "workspace:*",
    "@sciencediscovery/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "react": "19.2.7"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
