{
  "name": "@sciencediscovery/plugin-uniprot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./dist/manifest.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sciencediscovery/plugin-sdk": "workspace:*",
    "@sciencediscovery/mcp-sources": "workspace:*",
    "@sciencediscovery/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.1"
  }
}
